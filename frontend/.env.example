# Firebase web app configuration, from Firebase Console > Project settings.
# These identify the project and are not service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend API URL — set this in Vercel environment variables.
# Point it to the deployed Vultr backend (no trailing slash).
VITE_API_URL=http://65.20.74.149:3000
